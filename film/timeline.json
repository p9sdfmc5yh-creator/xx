{
 "_about": {
  "what": "Every text element of the original 41.6 s film (1248 frames @30 fps, 1920x1080), reverse-engineered from the frames. Rendered by film/compose/text.py.",
  "units": "All geometry in 1920x1080 pixels (pixel i covers [i,i+1)); frames are 0-based; colours 0-255 sRGB; opacities 0-1.",
  "font": "Noto Serif CJK SC (Source Han Serif SC) OTFs, weight per element. Original = Pillow/FreeType, one glyph at a time, integer px size, integer baseline, pen x rounded half-up.",
  "layout": "advance_i = font_units*size/1000 (un-hinted); width = sum(advance)+tracking*(n-1); x0 = anchor_x - width/2; pen_i = floor(x_i+0.5); x_{i+1} = x_i+advance_i+tracking. tracking = tracking_em*size. anchor = [centre x of the run, baseline y]. Optional 'pens' = explicit integer pen x per character (overrides the tracking model; only c_sub needs it: its measured pens deviate by 1 px from any single tracking value).",
  "fill": "fill colour x fill_opacity (notes are white at 0.75).",
  "halo": "gaussian-blurred copy of the glyph coverage drawn under the text: colour, blur = gaussian sigma in px, opacity (peak alpha multiplier), dx/dy offset. Black for light text ('shadow'), white for the dark labels ('glow'). Measured accuracy: sigma +-3 px, opacity +-0.1 (dark backgrounds make it nearly invisible on the 2D cards).",
  "opacity": "keyframes [frame, value, easing-to-next-key]; frames may be fractional (the original animated in seconds); value is constant before the first and after the last key; easing 'linear' or 'smoothstep' (3u^2-2u^3). The element is drawn only for start <= frame < end. The whole element (text + halo) is multiplied by the opacity.",
  "motion": "none: every element is static (measured drift < 0.05 px during all fades).",
  "producer_name": "elements with is_producer_name=true (i1_name, o3_name) draw producer_name_new; text.py use_old_name=True swaps in producer_name_old for verification only. Both names are 3 full-width glyphs, so the layout is identical.",
  "global_fade": "multiplier on the FINAL composite in gamma space (measured multiplicative at all levels): 1 until frame 1222, smoothstep to 0 at frame 1246; frames 1246-1247 are black. There is no fade-in at frame 0 and no other global fade or cross-fade. Not baked into the text layer.",
  "montage": "448-608 (ten 16-frame shots) and 608-736 (sixteen 8-frame shots): labels are fully opaque on the first through the last frame of each shot - hard cuts, no fades, no motion.",
  "backdrop_notes": "frames 736-751 are one held dim backdrop frame without text; the outro backdrop jumps to its normal state at 752 while the title fades in 751->754."
 },
